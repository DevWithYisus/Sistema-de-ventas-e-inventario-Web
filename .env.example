# Copia este archivo como .env (que NO se sube a GitHub) y cambia todos los valores.
# docker compose lo lee automáticamente.

# Contraseña del usuario de la aplicación en PostgreSQL (ventas_app)
VENTAS_APP_PASSWORD=cambia_esta_clave

# Firma de los tokens JWT: mínimo 32 caracteres aleatorios
JWT_KEY=cambia_esta_clave_por_una_de_al_menos_32_caracteres

# Clave para crear negocios nuevos (cabecera X-Plataforma-Key): mínimo 16 caracteres
PLATAFORMA_CLAVE=cambia_esta_clave_16

# Sitio del frontend que puede llamar a la API
CORS_ORIGEN=http://localhost:5173
